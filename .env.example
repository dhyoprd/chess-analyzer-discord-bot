# Salin ke .env dan isi nilainya. JANGAN commit .env — repo ini publik.
#   Copy-Item .env.example .env

# ─── Discord ────────────────────────────────────────────────────────────────
# Satu application object merangkap bot + Activity.
# Developer Portal -> Applications -> <app> -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Developer Portal -> Applications -> <app> -> General Information
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ID server Discord tempat bot dipakai. Bot ini dirancang untuk SATU guild saja.
DISCORD_GUILD_ID=

# ─── Stockfish ──────────────────────────────────────────────────────────────
# Jalur absolut ke binary. Di host: engine/stockfish.exe
# Di container (bila nanti dipakai): /app/engine/stockfish
STOCKFISH_PATH=engine/stockfish.exe

# Thread & hash untuk analisa. Mesin ini punya 28 core logis.
#
# 4 thread (bukan core - 1 atau - 2): satu worker analisa berjalan di mesin yang
# SAMA dengan bot Discord dan backend. Bot harus tetap menjawab slash command
# selama analisa berjalan, jadi engine sengaja TIDAK diberi seluruh core.
# Hash 128 MB dengan hashfull dijaga di bawah ~30%.
STOCKFISH_THREADS=4
STOCKFISH_HASH_MB=128

# Anggaran node per posisi. Analisa memakai `go nodes`, BUKAN `go depth`:
# depth yang dilaporkan Stockfish hanyalah estimasi, sehingga biaya per posisi
# tidak bisa dijanjikan. Dengan `go nodes`, biaya per posisi bisa dijanjikan.
#
# Diukur pada mesin ini (Stockfish 19, 4 thread, Hash 128 MB):
#   ~0,2-0,5 detik per posisi, mencapai depth 19-20 di posisi middlegame.
#   Satu game 40 langkah (81 posisi) selesai dalam ~20-40 detik.
#   8 game turnamen yang selesai bersamaan ~3-5 menit antrian.
#   Rentangnya lebar karena mesin ini juga menjalankan bot dan backend.
#   Ukur ulang dengan: backend/tools/bench_analysis_nodes.py
#
# CATATAN REPRODUKSIBILITAS: dengan Threads > 1, Stockfish memakai Lazy SMP,
# sehingga hasil TIDAK deterministik sempurna antar-analisa (eval bervariasi
# ~±5cp). Yang bisa direproduksi adalah BIAYA-nya (jumlah node), bukan hasilnya.
# Untuk hasil yang identik persis, Threads harus 1 (terukur ~3x lebih lambat).
STOCKFISH_NODES=1000000

# Timeout per panggilan engine. Longgar dengan sengaja: posisi rumit pada
# anggaran 1 juta node bisa memakan lebih dari default python-chess (10 detik),
# dan satu panggilan yang menggantung membekukan SELURUH antrian (satu worker).
STOCKFISH_TIMEOUT_SECONDS=60

# ─── Database ───────────────────────────────────────────────────────────────
# State otoritatif (ADR-0002). SQLite; /data di-abaikan .gitignore.
DATABASE_PATH=data/chess.db

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
