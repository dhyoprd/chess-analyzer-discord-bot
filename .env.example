# Salin ke .env dan isi nilainya. JANGAN commit .env — repo ini publik.
#   Copy-Item .env.example .env

# ─── Discord ────────────────────────────────────────────────────────────────
# Satu application object merangkap bot + Activity.
# Developer Portal -> Applications -> <app> -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Developer Portal -> Applications -> <app> -> General Information
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ID server Discord tempat bot dipakai. Bot ini dirancang untuk SATU guild saja.
DISCORD_GUILD_ID=

# ─── Stockfish ──────────────────────────────────────────────────────────────
# Jalur absolut ke binary. Di host: engine/stockfish.exe
# Di container (bila nanti dipakai): /app/engine/stockfish
STOCKFISH_PATH=engine/stockfish.exe

# Thread & hash untuk analisa. Mesin ini punya 28 core logis.
# Saran riset: Threads = core - 1 atau - 2; jaga hashfull di bawah ~30%.
STOCKFISH_THREADS=6
STOCKFISH_HASH_MB=256

# Depth analisa. Riset: game 40 langkah ~1-5 menit pada depth 18-20.
STOCKFISH_DEPTH=18

# ─── Database ───────────────────────────────────────────────────────────────
# State otoritatif (ADR-0002). SQLite; /data di-abaikan .gitignore.
DATABASE_PATH=data/chess.db

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
