# ─────────────────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
.vite/

# Log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─────────────────────────────────────────────────────────────────────────────
