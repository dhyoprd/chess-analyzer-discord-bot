# ─────────────────────────────────────────────────────────────────────────────
# graft's local graph cache — regenerable, not committed (run `graft build`).
# JANGAN hapus: .ignore bergantung pada entri ini untuk mendaftarkan ulang
# pohon graft ke ripgrep. Lihat .ignore.
/graft/

# ─────────────────────────────────────────────────────────────────────────────
# RAHASIA — repo ini PUBLIK. Jangan pernah commit berkas di bawah ini.
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/
client_secret*.json
credentials.json
token.json

# ─────────────────────────────────────────────────────────────────────────────
# Engine — binary 98 MB, tidak masuk repo. Lisensinya WAJIB ikut (GPL-3.0).
# ─────────────────────────────────────────────────────────────────────────────
/engine/stockfish
/engine/stockfish.exe
/engine/*.zip

# ─────────────────────────────────────────────────────────────────────────────
# State otoritatif — data pemain/game lokal. Bukan milik repo.
# ─────────────────────────────────────────────────────────────────────────────
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtualenv — uv menaruhnya di backend/.venv
.venv/
venv/
ENV/
env/
.python-version

# Build & distribusi
build/
dist/
*.egg-info/
*.egg
wheels/

# Test & alat
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
hypothesis/

# ─────────────────────────────────────────────────────────────────────────────
